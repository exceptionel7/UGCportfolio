# =========================================================================
# Exceptionel Platform — environment variables
# Copy to `.env` for local dev, and set the same keys in Vercel → Project →
# Settings → Environment Variables for production.
# NEVER commit real values. NEVER expose secret keys in client code.
# Only NEXT_PUBLIC_* values are sent to the browser.
# =========================================================================

# ---- Database (Phase 2) — REQUIRED ----
# Vercel Postgres / Supabase / Neon connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/exceptionel?schema=public"
# Prisma direct URL (for migrations when using a pooled DATABASE_URL, e.g. Neon/Supabase pooler).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/exceptionel?schema=public"

# ---- Auth.js (Phase 1 & 3) — REQUIRED ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public base URL of the app (used for callbacks / email links).
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Optional OAuth (Phase 3, optional) — NOT CONNECTED unless set ----
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Stripe (Phases 8/9/10/11/13/14) — NOT CONNECTED unless set ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---- Email — Resend (Phase 12) — NOT CONNECTED unless set ----
RESEND_API_KEY=""
EMAIL_FROM="Exceptionel <noreply@exceptionelstudio.com>"

# ---- File storage — Vercel Blob (Phase 7) — NOT CONNECTED unless set ----
BLOB_READ_WRITE_TOKEN=""

# ---- TikTok Shop (Phase 16) — NOT CONNECTED / pending approval ----
TIKTOK_SHOP_APP_KEY=""
TIKTOK_SHOP_APP_SECRET=""

# ---- Platform economics (Phase 9) ----
PLATFORM_FEE_PERCENT="15"

# ---- First admin (used by `npm run db:seed`) ----
# ADMIN is created server-side only — never via public signup.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
